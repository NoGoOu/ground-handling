# The front door of the production server (CLAUDE.md, 13. mérföldkő): Caddy
# gets and renews the Let's Encrypt certificate for DOMAIN by itself, sends
# plain HTTP over to HTTPS, and passes the requests to the app. For DOMAIN
# localhost it uses its own local certificate, so the setup can be tried on a
# workstation.

{$DOMAIN} {
	encode zstd gzip

	header {
		# HTTPS only, for a year (HSTS); no subdomains, no preload list.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Caddy sets X-Forwarded-For and X-Forwarded-Proto: the app reads the
	# client's address (login limits) and knows the request came over HTTPS.
	reverse_proxy app:3000
}
