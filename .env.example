# Copy to .env for local development (npm run dev against the Docker database).
DATABASE_URL="postgresql://ground_handling:ground_handling@localhost:5432/ground_handling"

# Secret for signing session cookies. Generate one with: npx auth secret
AUTH_SECRET="change-me-local-development-secret"

# Sending messages by email (7. mérföldkő). Left unset, nothing is sent: the
# delivery is only logged ("nem küldhető"). Set these only for a real SMTP server.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
