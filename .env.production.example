# Production settings (CLAUDE.md, 13. mérföldkő). On the server, copy this file
# to ".env" next to docker-compose.prod.yml and fill in every value. Never commit
# the filled-in file: it holds secrets.
#
# The app checks these when it starts and refuses to start while one is missing
# or wrong (it names the setting, never the value).

# The domain of the server, without https:// (its DNS A/AAAA record points here).
# Caddy gets the certificate for it from Let's Encrypt.
DOMAIN=

# The public address of the app: https:// and the domain above. The roster
# calendar links are made from it.
APP_PUBLIC_URL=

# Secret for signing the session cookies, at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Password of the database, at least 16 characters.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Sending messages by email (7. mérföldkő). Optional: left empty, nothing is
# sent, deliveries are only logged.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# The daily backup (optional; placeholders): when, Budapest time (HH:MM), and
# for how many days the backups are kept in ./backups.
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
