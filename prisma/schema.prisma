generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// All DateTime values are stored in UTC and shown in Europe/Budapest time.

/// Scope of a permission: own, the teams the user leads, or everyone.
enum PermissionScope {
  SELF
  TEAM
  ALL
}

enum MilestoneAnchor {
  ARRIVAL
  DEPARTURE
}

enum MilestonePart {
  ARRIVAL_PART
  DEPARTURE_PART
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

/// Global settings, a single row with id "global" (decision 7).
model Setting {
  id                        String   @id @default("global")
  /// Deviation up to this many minutes is green.
  deviationGreenMaxMinutes  Int      @default(0)
  /// Deviation up to this many minutes is yellow, above it red.
  deviationYellowMaxMinutes Int      @default(5)
  /// A qualification expiring within this many days is "hamarosan lejár" (6. mérföldkő).
  expiryWarningDays         Int      @default(30)
  /// The sender of the messages we send (7. mérföldkő).
  senderEmail               String?
  senderTypeB               String?
  /// A slot warning when the planned off-block is later than the target off-block by more (8. mérföldkő).
  slotToleranceMinutes      Int      @default(10)
  /// A deadline of ground equipment within this many days is "hamarosan lejár" (11. mérföldkő).
  equipmentWarningDays      Int      @default(30)
  /// The refresh time suggested to the calendars subscribed to a roster, in minutes (12. mérföldkő).
  calendarRefreshMinutes    Int      @default(60)
  updatedAt                 DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  active       Boolean  @default(true)
  teamId       String?
  team         Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles              UserRole[]
  permissions        UserPermission[]
  ledTeams           Team[]            @relation("TeamLeader")
  publications       Publication[]     @relation("PublishedBy")
  arrivalTasks       Task[]            @relation("ArrivalAgent")
  departureTasks     Task[]            @relation("DepartureAgent")
  recordedMilestones MilestoneRecord[] @relation("RecordedBy")
  updatedMilestones  MilestoneRecord[] @relation("UpdatedBy")
  shifts             Shift[]
  etaRecords         Flight[]          @relation("EtaRecordedBy")
  etdRecords         Flight[]          @relation("EtdRecordedBy")
  arrivalCancels     Flight[]          @relation("ArrivalCancelledBy")
  departureCancels   Flight[]          @relation("DepartureCancelledBy")
  flightEvents       FlightEvent[]
  importProfiles     ImportProfile[]
  importRuns         ImportRun[]
  importUploads      ImportUpload[]
  plansCreated       Plan[]            @relation("PlansCreated")
  planPositions      PlanPosition[]
  trainingRecords    TrainingRecord[]  @relation("TrainingRecords")
  recordsCreated     TrainingRecord[]  @relation("TrainingRecordsCreated")
  recordsUpdated     TrainingRecord[]  @relation("TrainingRecordsUpdated")
  filesUploaded      TrainingFile[]    @relation("TrainingFilesUploaded")
  filesRemoved       TrainingFile[]    @relation("TrainingFilesRemoved")
  messagesCreated    Message[]         @relation("MessagesCreated")
  messagesDiscarded  Message[]         @relation("MessagesDiscarded")
  delayRecords       DelayRecord[]     @relation("DelayRecordsCreated")
  delayUpdates       DelayRecord[]     @relation("DelayRecordsUpdated")
  apiKeys            ApiKey[]
  delayDocsUploaded  DelayCodeDocument[] @relation("DelayCodeDocumentsUploaded")
  delayDocsRemoved   DelayCodeDocument[] @relation("DelayCodeDocumentsRemoved")
  // Training with e-exams, OJT and release (10. mérföldkő).
  trainingProcesses  TrainingProcess[] @relation("TrainingProcesses")
  processesStarted   TrainingProcess[] @relation("TrainingProcessesStarted")
  processesAborted   TrainingProcess[] @relation("TrainingProcessesAborted")
  processesReleased  TrainingProcess[] @relation("TrainingProcessesReleased")
  attemptsOpened     ExamAttempt[]     @relation("ExamAttemptsOpened")
  attemptsGraded     ExamAttempt[]     @relation("ExamAttemptsGraded")
  answersGraded      ExamAnswer[]      @relation("ExamAnswersGraded")
  ojtAsTrainee       OjtSession[]      @relation("OjtTrainee")
  ojtAdded           OjtSession[]      @relation("OjtAdded")
  ojtAsMentor        OjtSession[]      @relation("OjtMentor")
  practicalExams     PracticalExam[]   @relation("PracticalExaminer")
  // Ground equipment and faults (11. mérföldkő).
  equipmentValues    EquipmentValue[]    @relation("EquipmentValuesUpdated")
  equipmentChanges   EquipmentValueLog[] @relation("EquipmentValueChanges")
  equipmentEvents    EquipmentEvent[]    @relation("EquipmentEvents")
  equipmentDocsUp    EquipmentDocument[] @relation("EquipmentDocumentsUploaded")
  equipmentDocsDown  EquipmentDocument[] @relation("EquipmentDocumentsRemoved")
  faultsReported     Fault[]             @relation("FaultsReported")
  faultsTaken        Fault[]             @relation("FaultsTaken")
  faultsClosed       Fault[]             @relation("FaultsClosed")
  faultPhotos        FaultPhoto[]        @relation("FaultPhotosUploaded")
  faultComments      FaultComment[]      @relation("FaultComments")
  faultEvents        FaultEvent[]        @relation("FaultEvents")
  calendarFeed       CalendarFeed?
}

/// A role is a name plus the permissions ticked for it (CLAUDE.md, "Jogosultsági rendszer").
model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  /// The Admin role cannot be edited or deleted.
  builtIn   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  id         String          @id @default(cuid())
  roleId     String
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Key from the permission catalogue in the code.
  permission String
  scope      PermissionScope @default(ALL)

  @@unique([roleId, permission])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// Extra permission given to one user on top of their roles. There is no individual revoke.
model UserPermission {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  scope      PermissionScope @default(ALL)

  @@unique([userId, permission])
}

/// A team has one leader; the "team" scope covers the members of the teams a user leads.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  leaderId  String
  leader    User     @relation("TeamLeader", fields: [leaderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members User[] @relation("TeamMembers")
}

/// The three layers of the roster (CLAUDE.md, "Beosztás rétegei").
enum RosterLayer {
  DRAFT
  PUBLISHED
  ACTUAL
}

/// Types of shift segment; only operative ones may carry flight tasks.
model SegmentType {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  operative Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments         ShiftSegment[]
  planningSettings PlanningSetting[]
}

/// One published period; the days it covers cannot be published again.
model Publication {
  id            String   @id @default(cuid())
  /// Local (Europe/Budapest) days, stored as the UTC instant of local midnight.
  startDate     DateTime
  endDate       DateTime
  publishedById String
  publishedBy   User     @relation("PublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime @default(now())

  shifts Shift[]

  @@index([startDate])
}

/// One agent's shift in one layer; its start and end come from its segments.
model Shift {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  layer         RosterLayer
  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id])
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  segments  ShiftSegment[]
  /// Set when "Mentés a tervezetbe" made this draft shift from a plan day; the
  /// next save of that day replaces it while it is still a draft.
  planDayId String?
  planDay   PlanDay?       @relation(fields: [planDayId], references: [id], onDelete: SetNull)

  @@index([userId, layer])
}

/// A part of a shift: time, type, and optionally a block with travel time.
model ShiftSegment {
  id                  String      @id @default(cuid())
  shiftId             String
  shift               Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  start               DateTime
  end                 DateTime
  segmentTypeId       String
  segmentType         SegmentType @relation(fields: [segmentTypeId], references: [id])
  location            String?
  description         String?
  /// Non-operative segments can show up as a block in the daily assignment.
  createBlock         Boolean     @default(false)
  /// Travel to and from the segment, in minutes; the block is widened by these.
  travelBeforeMinutes Int         @default(0)
  travelAfterMinutes  Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([shiftId])
  @@index([start])
}

model Airline {
  id        String               @id @default(cuid())
  name      String
  iataCode  String               @unique
  templates TurnaroundTemplate[] @relation("AirlineTemplates")
  flights   Flight[]
  /// The task types its flights get (5. mérföldkő); replaces the default template.
  taskTypes AirlineTaskType[]
  /// Who gets its messages (7. mérföldkő).
  addresses AddressBookEntry[]
  /// Its own delay code document and the log of the earlier ones (8. mérföldkő, utómunka).
  delayCodeDocuments DelayCodeDocument[]
}

/// A kind of work on a flight, e.g. GOU or HDS (5. mérföldkő). Every flight has
/// one task per task type of its airline.
model TaskType {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates TurnaroundTemplate[]
  airlines  AirlineTaskType[]
  tasks     Task[]
}

/// The task types an airline's flights need, each with its template. One of
/// them is primary: its ATA/ATD records are the flight's when the external
/// system has none. Changes only reach new flights.
model AirlineTaskType {
  id         String             @id @default(cuid())
  airlineId  String
  airline    Airline            @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  taskTypeId String
  taskType   TaskType           @relation(fields: [taskTypeId], references: [id])
  templateId String
  template   TurnaroundTemplate @relation(fields: [templateId], references: [id])
  active     Boolean            @default(true)
  isPrimary  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  /// The qualifications its parts need (6. mérföldkő).
  requirements TaskRequirement[]

  @@unique([airlineId, taskTypeId])
}

model TurnaroundTemplate {
  id                     String   @id @default(cuid())
  airlineId              String
  airline                Airline  @relation("AirlineTemplates", fields: [airlineId], references: [id])
  /// The task type the template is for (5. mérföldkő).
  taskTypeId             String
  taskType               TaskType @relation(fields: [taskTypeId], references: [id])
  /// The parts the template has; at least one (5. mérföldkő).
  arrivalPart            Boolean  @default(true)
  departurePart          Boolean  @default(true)
  name                   String
  minTurnaroundMinutes   Int
  travelMinutes          Int
  postDepartureMinutes   Int
  departureReportMinutes Int
  minBreakMinutes        Int

  milestones MilestoneDefinition[]
  tasks      Task[]
  usedBy     AirlineTaskType[]

  @@unique([airlineId, name])
}

model MilestoneDefinition {
  id            String             @id @default(cuid())
  templateId    String
  template      TurnaroundTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order         Int
  code          String
  name          String
  anchor        MilestoneAnchor
  offsetMinutes Int
  required      Boolean
  part          MilestonePart

  records MilestoneRecord[]

  @@unique([templateId, code])
}

model Flight {
  id                   String    @id @default(cuid())
  airlineId            String
  airline              Airline   @relation(fields: [airlineId], references: [id])
  /// The arrival part (flight number, STA, ETA, ATA) and the departure part
  /// (flight number, STD, ETD, ATD) are each optional, but one must exist
  /// (rule 11). Check constraints in the migration keep each part whole.
  inboundFlightNumber  String?
  outboundFlightNumber String?
  sta                  DateTime?
  eta                  DateTime?
  std                  DateTime?
  etd                  DateTime?
  /// Unknown until the shift lead sets it (an imported flight has none).
  stand                String?

  // 3. mérföldkő: where the flight comes from, and what identifies its legs.
  source              FlightSource   @default(MANUAL)
  /// Origin of the arrival part and destination of the departure part.
  origin              String?
  destination         String?
  /// Operating dates of the two legs (the departure day at the leg's origin).
  arrivalFlightDate   DateTime?      @db.Date
  departureFlightDate DateTime?      @db.Date
  aircraftType        String?
  aircraftConfig      String?
  importProfileId     String?
  importProfile       ImportProfile? @relation(fields: [importProfileId], references: [id])
  /// "Az utolsó importból hiányzik", per part, until the planner clears it.
  arrivalMissing      Boolean        @default(false)
  departureMissing    Boolean        @default(false)
  missingImportRunId  String?
  missingImportRun    ImportRun?     @relation("MissingFromImport", fields: [missingImportRunId], references: [id])
  /// From the external system.
  ata                 DateTime?
  /// From the external system.
  atd                 DateTime?
  /// Per part (7. mérföldkő): a message fills it when empty.
  arrivalRegistration   String?
  departureRegistration String?
  /// The flight plan id of the departure (8. mérföldkő): later slot messages match by it.
  departureIfplid       String?

  // "Késés és törlés": where the current ETA and ETD came from.
  etaSource       EstimateSource?
  etaNote         String?
  etaRecordedById String?
  etaRecordedBy   User?           @relation("EtaRecordedBy", fields: [etaRecordedById], references: [id])
  etaRecordedAt   DateTime?
  etdSource       EstimateSource?
  etdNote         String?
  etdRecordedById String?
  etdRecordedBy   User?           @relation("EtdRecordedBy", fields: [etdRecordedById], references: [id])
  etdRecordedAt   DateTime?

  // Each part can be cancelled on its own; the flight itself is never deleted.
  arrivalCancelled       Boolean   @default(false)
  arrivalCancelledById   String?
  arrivalCancelledBy     User?     @relation("ArrivalCancelledBy", fields: [arrivalCancelledById], references: [id])
  arrivalCancelledAt     DateTime?
  departureCancelled     Boolean   @default(false)
  departureCancelledById String?
  departureCancelledBy   User?     @relation("DepartureCancelledBy", fields: [departureCancelledById], references: [id])
  departureCancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One task per task type of the airline (5. mérföldkő; until then one).
  tasks        Task[]
  events       FlightEvent[]
  messages     Message[]
  delayRecords DelayRecord[]

  @@unique([airlineId, inboundFlightNumber, arrivalFlightDate, origin])
  @@unique([airlineId, outboundFlightNumber, departureFlightDate, destination])
  @@index([departureIfplid])
  @@index([sta])
  @@index([std])
}

model Task {
  id               String             @id @default(cuid())
  flightId         String
  flight           Flight             @relation(fields: [flightId], references: [id], onDelete: Cascade)
  /// One task per task type on a flight (5. mérföldkő).
  taskTypeId       String
  taskType         TaskType           @relation(fields: [taskTypeId], references: [id])
  /// The task's own template: the one of its task type when the flight was made.
  templateId       String
  template         TurnaroundTemplate @relation(fields: [templateId], references: [id])
  /// The primary task's ATA/ATD records are the flight's when the external
  /// system has none. Fixed when the task is made.
  isPrimary        Boolean            @default(false)
  status           TaskStatus         @default(PLANNED)
  arrivalAgentId   String?
  arrivalAgent     User?              @relation("ArrivalAgent", fields: [arrivalAgentId], references: [id])
  departureAgentId String?
  departureAgent   User?              @relation("DepartureAgent", fields: [departureAgentId], references: [id])
  /// Template parameters and milestone definitions frozen when the task is completed.
  templateSnapshot Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  records   MilestoneRecord[]
  planItems PlanItem[]
  /// Trainees next to its agents and practical exams on it (10. mérföldkő).
  ojtSessions    OjtSession[]
  practicalExams PracticalExam[]

  @@unique([flightId, taskTypeId])
  @@index([flightId])
}

model MilestoneRecord {
  id                    String              @id @default(cuid())
  taskId                String
  task                  Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestoneDefinitionId String
  milestoneDefinition   MilestoneDefinition @relation(fields: [milestoneDefinitionId], references: [id])
  /// Minute precision (seconds cut off).
  actualTime            DateTime
  recordedById          String
  recordedBy            User                @relation("RecordedBy", fields: [recordedById], references: [id])
  recordedAt            DateTime            @default(now())
  /// Set on the first correction, null until then.
  updatedById           String?
  updatedBy             User?               @relation("UpdatedBy", fields: [updatedById], references: [id])
  updatedAt             DateTime?
  /// Recorded, or last corrected, by the trainee of the part (10. mérföldkő).
  byTrainee             Boolean             @default(false)
  updatedByTrainee      Boolean             @default(false)

  @@unique([taskId, milestoneDefinitionId])
}

enum EstimateSource {
  MANUAL
  MESSAGE
}

enum FlightEventKind {
  DELAY
  CANCEL
  RESTORE
  /// An ATA or ATD from a message (7. mérföldkő).
  ACTUAL
  /// A registration from a message.
  REGISTRATION
  /// Delay codes from a message.
  DELAY_CODES
}

/// Log of delays, cancellations and restorations on a flight: who, when, what.
model FlightEvent {
  id          String          @id @default(cuid())
  flightId    String
  flight      Flight          @relation(fields: [flightId], references: [id], onDelete: Cascade)
  kind        FlightEventKind
  /// The cancelled or restored part; null for a delay.
  part        MilestonePart?
  /// The new estimates of a delay.
  eta         DateTime?
  etd         DateTime?
  source      EstimateSource?
  note        String?
  /// ACTUAL: the new ATA or ATD; REGISTRATION: the registration.
  ata          DateTime?
  atd          DateTime?
  registration String?
  /// The message the change comes from (7. mérföldkő).
  messageId   String?
  message     Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  /// Null when a message received through the API made the change.
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([flightId, createdAt])
}

enum FlightSource {
  MANUAL
  IMPORT
}

/// A saved column mapping; offered again for a file with the same header.
model ImportProfile {
  id                String   @id @default(cuid())
  name              String   @unique
  /// Hash of the normalised header row of the file the profile was made for.
  headerFingerprint String
  /// Sheet, header row, column mapping, transformations and filters.
  mapping           Json
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  flights Flight[]
  runs    ImportRun[]

  @@index([headerFingerprint])
}

/// Log of a saved import: who, when, which file, which profile, and the summary.
model ImportRun {
  id          String         @id @default(cuid())
  profileId   String?
  profile     ImportProfile? @relation(fields: [profileId], references: [id])
  fileName    String
  fileSize    Int
  rangeStart  DateTime       @db.Date
  rangeEnd    DateTime       @db.Date
  summary     Json
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  missingFlights Flight[] @relation("MissingFromImport")

  @@index([createdAt])
}

/// An uploaded file kept between the steps of the import; removed after a day.
model ImportUpload {
  id          String   @id @default(cuid())
  fileName    String
  size        Int
  content     Bytes
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// 4. mérföldkő: tervezői nézet, automatikus kiosztással.

/// The rules of the automatic plan (CLAUDE.md, "Tervezési beállítások").
/// One row; a plan day keeps its own copy from its calculation.
model PlanningSetting {
  id                String       @id @default("global")
  minShiftMinutes   Int          @default(240)
  maxShiftMinutes   Int          @default(720)
  breakMinutes      Int          @default(20)
  /// A shift longer than this needs a break.
  breakAfterMinutes Int          @default(360)
  /// Rest between two tasks; only one of rest and overlap may be above zero.
  restMinutes       Int          @default(0)
  /// Allowed overlap of two tasks.
  overlapMinutes    Int          @default(0)
  /// Positions allowed above the minimum, for an even load.
  extraPositions    Int          @default(0)
  /// Type of the single segment "Mentés a tervezetbe" writes (Műszak by default).
  segmentTypeId     String?
  segmentType       SegmentType? @relation(fields: [segmentTypeId], references: [id], onDelete: SetNull)
  updatedAt         DateTime     @updatedAt
}

/// The part of a task an occupancy window covers: WHOLE on a quick turnaround.
enum WindowPart {
  WHOLE
  ARRIVAL_PART
  DEPARTURE_PART
}

/// A plan for a period (Budapest days); it is calculated day by day.
model Plan {
  id          String   @id @default(cuid())
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  createdById String
  createdBy   User     @relation("PlansCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days PlanDay[]
}

/// One day of a plan. Its items are the day's windows as calculated: when
/// the windows of the tasks change, the day is stale.
model PlanDay {
  id           String   @id @default(cuid())
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  /// The planning settings at the calculation.
  settings     Json
  calculatedAt DateTime

  positions PlanPosition[]
  items     PlanItem[]
  /// Draft shifts saved from this day.
  shifts    Shift[]

  @@unique([planId, date])
}

/// A nameless position ("1. pozíció"): a future shift.
model PlanPosition {
  id     String  @id @default(cuid())
  dayId  String
  day    PlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  number Int
  /// The agent the planner names for the position.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items PlanItem[]

  @@unique([dayId, number])
}

/// An occupancy window in a position, with its times at the calculation.
model PlanItem {
  id         String       @id @default(cuid())
  dayId      String
  day        PlanDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  positionId String
  position   PlanPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  part       WindowPart
  start      DateTime
  end        DateTime
  /// Moved by hand; a recalculation overwrites it.
  manual     Boolean      @default(false)

  @@unique([dayId, taskId, part])
  @@index([positionId])
}

// 6. mérföldkő: képzések és jogosítások.

/// A qualification ("funkció") an agent gets from a training.
model Qualification {
  id             String   @id @default(cuid())
  name           String   @unique
  code           String   @unique
  /// How many months a pass is valid for; null: it does not expire.
  validityMonths Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trainings    Training[]
  requirements TaskRequirement[]
}

model Training {
  id              String         @id @default(cuid())
  name            String         @unique
  /// The qualification a pass gives; a training may give none.
  qualificationId String?
  qualification   Qualification? @relation(fields: [qualificationId], references: [id])
  hasExam         Boolean        @default(false)
  /// The pass mark of the exam in percent; set exactly when there is an exam.
  passPercent     Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  /// The parts of the training (10. mérföldkő): theory closed by an e-exam
  /// (it needs the exam and its pass mark), practice with OJT and a practical exam.
  theoryPart                Boolean @default(false)
  practicalPart             Boolean @default(false)
  /// The OJT requirement; the defaults are placeholders (lib/exams/defaults.ts).
  ojtRequiredCount          Int     @default(10)
  ojtMinCompletenessPercent Int     @default(100)
  ojtMinOnTimePercent       Int     @default(0)

  records    TrainingRecord[]
  examSheets ExamSheet[]
  processes  TrainingProcess[]
  criteria   PracticalCriterion[]
}

/// One completion of a training by an agent. Corrected, never deleted.
model TrainingRecord {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation("TrainingRecords", fields: [userId], references: [id])
  trainingId       String
  training         Training  @relation(fields: [trainingId], references: [id])
  completedOn      DateTime  @db.Date
  /// The exam result in percent, when the training has an exam.
  examPercent      Int?
  /// From the exam result and the pass mark, or set by the coordinator without an exam.
  passed           Boolean
  /// End of validity: the completion day + the qualification's months, unless set by hand. Null: no end.
  validUntil       DateTime? @db.Date
  validUntilManual Boolean   @default(false)
  note             String?
  createdById      String
  createdBy        User      @relation("TrainingRecordsCreated", fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedById      String?
  updatedBy        User?     @relation("TrainingRecordsUpdated", fields: [updatedById], references: [id])
  updatedAt        DateTime  @updatedAt

  files TrainingFile[]
  /// The process whose release made it (10. mérföldkő); none for a record kept by hand.
  process TrainingProcess?

  @@index([userId])
}

/// A file attached to a training record, kept in the upload directory. A
/// removed file is gone from the disk; its row stays as the log.
model TrainingFile {
  id           String         @id @default(cuid())
  recordId     String
  record       TrainingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  /// The file's name in the upload directory; null once removed.
  storageKey   String?        @unique
  uploadedById String
  uploadedBy   User           @relation("TrainingFilesUploaded", fields: [uploadedById], references: [id])
  uploadedAt   DateTime       @default(now())
  removedById  String?
  removedBy    User?          @relation("TrainingFilesRemoved", fields: [removedById], references: [id])
  removedAt    DateTime?

  @@index([recordId])
}

/// A qualification one part of an airline's task type needs.
model TaskRequirement {
  id                String          @id @default(cuid())
  airlineTaskTypeId String
  airlineTaskType   AirlineTaskType @relation(fields: [airlineTaskTypeId], references: [id], onDelete: Cascade)
  part              MilestonePart
  qualificationId   String
  qualification     Qualification   @relation(fields: [qualificationId], references: [id])

  @@unique([airlineTaskTypeId, part, qualificationId])
}

// 7. mérföldkő: messages (docs/messages.md).

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSource {
  MANUAL
  API
  GENERATED
}

enum DeliveryChannel {
  EMAIL
  SITA
}

enum DeliveryStatus {
  SENT
  FAILED
  NOT_SENDABLE
}

/// A received or sent message: the raw text always stays.
model Message {
  id           String           @id @default(cuid())
  direction    MessageDirection
  /// MVT, LDM, CPM or UCM.
  type         String
  /// The message itself, verbatim (with its COR line); for PSM and PTM the counts derived from it.
  rawText      String
  /// A COR line came before it: it corrects an earlier message (8. mérföldkő).
  correction   Boolean          @default(false)
  /// The lines before the type line (Type B header, email text); not part of the hash.
  envelope     String?
  /// Hash of the normalised text of an inbound message, against duplicates.
  textHash     String?          @unique
  source       MessageSource
  apiKeyId     String?
  apiKey       ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  /// The "source" field of an API request.
  sourceNote   String?
  receivedAt   DateTime
  /// Header fields as read: flight number, day or date, registration, station or route.
  flightNumber String?
  headerDate   String?
  registration String?
  station      String?
  /// The resolved operating day.
  flightDate   DateTime?        @db.Date
  /// The parsed content, and the warnings as { code, params }.
  parsed       Json
  warnings     Json

  /// The flight part it belongs to; none while unmatched.
  flightId        String?
  flight          Flight?        @relation(fields: [flightId], references: [id], onDelete: Cascade)
  part            MilestonePart?
  /// Why it could not be matched.
  unmatchedReason String?
  /// Version: flight part + type + kind (docs/messages.md, "Verziók").
  kind            String?
  versionKey      String?
  supersedesId    String?        @unique
  supersedes      Message?       @relation("MessageVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    Message?       @relation("MessageVersions")
  /// The latest of its version key, the one that counts.
  current         Boolean        @default(false)
  discardedAt     DateTime?
  discardedById   String?
  discardedBy     User?          @relation("MessagesDiscarded", fields: [discardedById], references: [id])

  createdById String?
  createdBy   User?    @relation("MessagesCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  deliveries   MessageDelivery[]
  flightEvents FlightEvent[]
  delayRecords DelayRecord[]

  @@index([flightId, part])
  @@index([versionKey, current])
  @@index([receivedAt])
}

/// One recipient of an outbound message, with its outcome.
model MessageDelivery {
  id          String          @id @default(cuid())
  messageId   String
  message     Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient   String
  channel     DeliveryChannel
  status      DeliveryStatus
  error       String?
  attemptedAt DateTime        @default(now())

  @@index([messageId])
}

model DelayCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// An airline's own delay code document (8. mérföldkő, utómunka): one PDF per
/// airline, opened from its flights. The row is also the log: a replaced or
/// removed file is deleted from the storage and its row stays.
model DelayCodeDocument {
  id           String    @id @default(cuid())
  airlineId    String
  airline      Airline   @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  fileName     String
  size         Int
  /// The file's name in the upload directory; null once replaced or removed.
  storageKey   String?   @unique
  uploadedById String
  uploadedBy   User      @relation("DelayCodeDocumentsUploaded", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())
  removedById  String?
  removedBy    User?     @relation("DelayCodeDocumentsRemoved", fields: [removedById], references: [id])
  removedAt    DateTime?
  /// Whether a new upload took its place (else it was removed by hand).
  replaced     Boolean   @default(false)

  @@index([airlineId])
}

/// A delay code and its minutes on the departure part of a flight.
model DelayRecord {
  id          String         @id @default(cuid())
  flightId    String
  flight      Flight         @relation(fields: [flightId], references: [id], onDelete: Cascade)
  /// As given; a code missing from the table is kept, with a warning.
  code        String
  minutes     Int
  source      EstimateSource
  /// The message it comes from; a newer version replaces these.
  messageId   String?
  message     Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?          @relation("DelayRecordsCreated", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedById String?
  updatedBy   User?          @relation("DelayRecordsUpdated", fields: [updatedById], references: [id])
  updatedAt   DateTime       @updatedAt

  @@index([flightId])
}

/// A key of the receiving API; only its hash is stored.
model ApiKey {
  id          String    @id @default(cuid())
  name        String    @unique
  keyHash     String    @unique
  /// The first characters, to tell keys apart.
  prefix      String
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  messages Message[]
  calls    ApiCallLog[]
}

/// Every call of the receiving API: key, time, outcome.
model ApiCallLog {
  id       String   @id @default(cuid())
  apiKeyId String?
  apiKey   ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  at       DateTime @default(now())
  status   Int
  /// A short summary: message counts, or the error.
  result   String

  @@index([at])
}

/// A recognised but unsupported message (PTM, PSM): only its type, flight and
/// date, never the content, which may hold personal data.
model UnsupportedMessageLog {
  id           String        @id @default(cuid())
  type         String
  flightNumber String?
  headerDate   String?
  receivedAt   DateTime
  source       MessageSource
  createdAt    DateTime      @default(now())

  @@index([receivedAt])
}

/// A recipient of the messages of an airline of a type: an email or a SITA Type B address.
model AddressBookEntry {
  id          String          @id @default(cuid())
  airlineId   String
  airline     Airline         @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  messageType String
  channel     DeliveryChannel
  address     String
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([airlineId, messageType, address])
}

/// Airports by IATA and ICAO code (8. mérföldkő): slot messages name them by ICAO.
model Airport {
  id        String   @id @default(cuid())
  iataCode  String   @unique
  icaoCode  String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Training with e-exams, on the job training and release (10. mérföldkő).
// A process takes an agent through the parts of a training; its release makes
// the passed training record, and the qualification comes from that record as
// before (6. mérföldkő).

enum ExamQuestionKind {
  /// One right answer.
  SINGLE
  /// Several right answers.
  MULTIPLE
  /// A written answer, scored by the examiner.
  TEXT
}

/// How a question with several right answers scores (a placeholder rule, set per exam sheet).
enum MultipleChoiceScoring {
  /// Only the fully right answer scores.
  ALL_OR_NOTHING
  /// Points × (right ones marked − wrong ones marked) / all right ones, at least zero.
  PROPORTIONAL
}

enum TrainingProcessStatus {
  /// Running; "ready for release" is worked out from its parts.
  IN_PROGRESS
  RELEASED
  ABORTED
}

enum Verdict {
  PASS
  FAIL
}

/// A question of the question bank.
model ExamQuestion {
  id        String           @id @default(cuid())
  text      String
  kind      ExamQuestionKind
  points    Int              @default(1)
  topic     String?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  options ExamOption[]
  sheets  ExamSheetQuestion[]
}

/// An answer to choose for a single or multiple choice question.
model ExamOption {
  id         String       @id @default(cuid())
  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  correct    Boolean      @default(false)

  @@unique([questionId, order])
}

/// An exam sheet of a training: questions in order, an optional time limit.
model ExamSheet {
  id               String                @id @default(cuid())
  name             String                @unique
  trainingId       String
  training         Training              @relation(fields: [trainingId], references: [id])
  timeLimitMinutes Int?
  multipleScoring  MultipleChoiceScoring @default(ALL_OR_NOTHING)
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  questions ExamSheetQuestion[]
  attempts  ExamAttempt[]
}

model ExamSheetQuestion {
  id         String       @id @default(cuid())
  sheetId    String
  sheet      ExamSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id])
  order      Int

  @@unique([sheetId, questionId])
  @@index([sheetId])
}

/// One agent going through the parts of one training.
model TrainingProcess {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation("TrainingProcesses", fields: [userId], references: [id])
  trainingId   String
  training     Training              @relation(fields: [trainingId], references: [id])
  status       TrainingProcessStatus @default(IN_PROGRESS)
  /// "userId:trainingId" while the process is open: one open process per agent and training.
  openKey      String?               @unique
  startedById  String
  startedBy    User                  @relation("TrainingProcessesStarted", fields: [startedById], references: [id])
  startedAt    DateTime              @default(now())
  abortedById  String?
  abortedBy    User?                 @relation("TrainingProcessesAborted", fields: [abortedById], references: [id])
  abortedAt    DateTime?
  abortReason  String?
  releasedById String?
  releasedBy   User?                 @relation("TrainingProcessesReleased", fields: [releasedById], references: [id])
  releasedAt   DateTime?
  /// The passed record the release made.
  recordId     String?               @unique
  record       TrainingRecord?       @relation(fields: [recordId], references: [id])

  attempts       ExamAttempt[]
  ojtSessions    OjtSession[]
  practicalExams PracticalExam[]

  @@index([userId])
}

/// One sitting of an e-exam. It keeps a copy of the sheet and its questions
/// from when it was opened, like the snapshot of a completed task.
model ExamAttempt {
  id           String          @id @default(cuid())
  processId    String
  process      TrainingProcess @relation(fields: [processId], references: [id])
  sheetId      String
  sheet        ExamSheet       @relation(fields: [sheetId], references: [id])
  snapshot     Json
  maxPoints    Int
  /// The process id while the attempt is open: one open attempt per process.
  openKey      String?         @unique
  openedById   String
  openedBy     User            @relation("ExamAttemptsOpened", fields: [openedById], references: [id])
  openedAt     DateTime        @default(now())
  /// The examinee's first look: the time limit runs from here.
  startedAt    DateTime?
  deadline     DateTime?
  submittedAt  DateTime?
  /// Set once every answer is scored.
  scoredPoints Float?
  passed       Boolean?
  /// Seen by the examinee too.
  feedback     String?
  /// Seen only by examiners, releasers and the coordinator.
  internalNote String?
  gradedById   String?
  gradedBy     User?           @relation("ExamAttemptsGraded", fields: [gradedById], references: [id])
  gradedAt     DateTime?

  answers ExamAnswer[]

  @@index([processId])
}

/// The answer to one question of an attempt, by its place in the copy.
model ExamAnswer {
  id            String      @id @default(cuid())
  attemptId     String
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionIndex Int
  /// The places of the chosen options in the copy.
  choices       Int[]
  text          String?
  /// Given by the system on submission (choice questions) or by the examiner (written answers).
  points        Float?
  graderNote    String?
  gradedById    String?
  gradedBy      User?       @relation("ExamAnswersGraded", fields: [gradedById], references: [id])
  gradedAt      DateTime?

  @@unique([attemptId, questionIndex])
}

/// A trainee next to the agent of a task part, the mentor; with the mentor's
/// evaluation after the task and the metrics frozen then.
model OjtSession {
  id          String          @id @default(cuid())
  taskId      String
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  part        MilestonePart
  traineeId   String
  trainee     User            @relation("OjtTrainee", fields: [traineeId], references: [id])
  processId   String
  process     TrainingProcess @relation(fields: [processId], references: [id])
  addedById   String
  addedBy     User            @relation("OjtAdded", fields: [addedById], references: [id])
  addedAt     DateTime        @default(now())
  verdict     Verdict?
  comment     String?
  metrics     Json?
  mentorId    String?
  mentor      User?           @relation("OjtMentor", fields: [mentorId], references: [id])
  evaluatedAt DateTime?

  @@unique([taskId, part])
  @@index([traineeId])
  @@index([processId])
}

/// A criterion of the practical exam of a training.
model PracticalCriterion {
  id         String   @id @default(cuid())
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id])
  order      Int
  text       String
  active     Boolean  @default(true)
  /// A knock-out criterion (10. mérföldkő, utómunka): failing it fails the exam, whatever the examiner says.
  knockOut   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([trainingId])
}

/// A practical exam on a real flight, a task part, judged by the examiner per criterion.
model PracticalExam {
  id           String          @id @default(cuid())
  processId    String
  process      TrainingProcess @relation(fields: [processId], references: [id])
  taskId       String
  task         Task            @relation(fields: [taskId], references: [id])
  part         MilestonePart
  examinerId   String
  examiner     User            @relation("PracticalExaminer", fields: [examinerId], references: [id])
  /// The criteria as they were, each with its verdict and note.
  results      Json
  verdict      Verdict
  feedback     String?
  internalNote String?
  createdAt    DateTime        @default(now())

  @@index([processId])
}

// ---------------------------------------------------------------------------
// Ground equipment and faults (11. mérföldkő): the technical register of every
// piece of ground equipment, and the faults anyone may report on them.

enum EquipmentFieldKind {
  /// A date that expires, watched like a qualification.
  DEADLINE
  /// A reading (operating hours or km) with an optional due value.
  COUNTER
  TEXT
}

enum EquipmentStatus {
  OPERATIONAL
  OUT_OF_SERVICE
  /// Taken out of use for good: equipment is never deleted.
  RETIRED
}

enum FaultStatus {
  OPEN
  /// Taken over by the technical staff.
  IN_PROGRESS
  CLOSED
}

enum FaultResolution {
  FIXED
  NOT_A_FAULT
}

/// A kind of ground equipment, with the list of its technical data fields.
model EquipmentType {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields    EquipmentField[]
  equipment Equipment[]
}

/// One technical data field of a type; never deleted, only made inactive.
model EquipmentField {
  id        String             @id @default(cuid())
  typeId    String
  type      EquipmentType      @relation(fields: [typeId], references: [id])
  name      String
  kind      EquipmentFieldKind
  /// The unit of a counter, e.g. "üzemóra" or "km".
  unit      String?
  order     Int
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  values EquipmentValue[]
  logs   EquipmentValueLog[]

  @@unique([typeId, name])
}

model Equipment {
  id          String          @id @default(cuid())
  typeId      String
  type        EquipmentType   @relation(fields: [typeId], references: [id])
  /// E.g. the fleet number.
  identifier  String          @unique
  plate       String?
  description String?
  status      EquipmentStatus @default(OPERATIONAL)
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  values    EquipmentValue[]
  valueLogs EquipmentValueLog[]
  events    EquipmentEvent[]
  documents EquipmentDocument[]
  faults    Fault[]

  @@index([typeId])
}

/// The value of one field of one piece of equipment.
model EquipmentValue {
  id          String         @id @default(cuid())
  equipmentId String
  equipment   Equipment      @relation(fields: [equipmentId], references: [id])
  fieldId     String
  field       EquipmentField @relation(fields: [fieldId], references: [id])
  /// A deadline.
  dateValue   DateTime?      @db.Date
  /// The reading of a counter, and the reading it is due at.
  numberValue Float?
  dueValue    Float?
  textValue   String?
  updatedById String
  updatedBy   User           @relation("EquipmentValuesUpdated", fields: [updatedById], references: [id])
  updatedAt   DateTime       @updatedAt

  @@unique([equipmentId, fieldId])
}

/// Every change of a value: who, when, the old and the new value.
model EquipmentValueLog {
  id          String         @id @default(cuid())
  equipmentId String
  equipment   Equipment      @relation(fields: [equipmentId], references: [id])
  fieldId     String
  field       EquipmentField @relation(fields: [fieldId], references: [id])
  oldValue    Json?
  newValue    Json?
  changedById String
  changedBy   User           @relation("EquipmentValueChanges", fields: [changedById], references: [id])
  changedAt   DateTime       @default(now())

  @@index([equipmentId])
}

/// A change of an equipment's status: a report, a repair, a retirement.
model EquipmentEvent {
  id          String           @id @default(cuid())
  equipmentId String
  equipment   Equipment        @relation(fields: [equipmentId], references: [id])
  fromStatus  EquipmentStatus?
  toStatus    EquipmentStatus
  note        String?
  /// The fault that made it, when one did.
  faultId     String?
  fault       Fault?           @relation(fields: [faultId], references: [id])
  createdById String
  createdBy   User             @relation("EquipmentEvents", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([equipmentId])
}

/// A file of a piece of equipment (registration, service sheet, photo). A
/// removed file is gone from the disk; its row stays as the log.
model EquipmentDocument {
  id           String    @id @default(cuid())
  equipmentId  String
  equipment    Equipment @relation(fields: [equipmentId], references: [id])
  fileName     String
  mimeType     String
  size         Int
  storageKey   String?   @unique
  uploadedById String
  uploadedBy   User      @relation("EquipmentDocumentsUploaded", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())
  removedById  String?
  removedBy    User?     @relation("EquipmentDocumentsRemoved", fields: [removedById], references: [id])
  removedAt    DateTime?

  @@index([equipmentId])
}

/// A fault reported on a piece of equipment, handled by the technical staff.
model Fault {
  id                   String           @id @default(cuid())
  equipmentId          String
  equipment            Equipment        @relation(fields: [equipmentId], references: [id])
  description          String
  /// The reporter marked the equipment out of service.
  reportedOutOfService Boolean          @default(false)
  status               FaultStatus      @default(OPEN)
  /// Set exactly when closed.
  resolution           FaultResolution?
  reportedById         String
  reportedBy           User             @relation("FaultsReported", fields: [reportedById], references: [id])
  reportedAt           DateTime         @default(now())
  takenById            String?
  takenBy              User?            @relation("FaultsTaken", fields: [takenById], references: [id])
  takenAt              DateTime?
  closedById           String?
  closedBy             User?            @relation("FaultsClosed", fields: [closedById], references: [id])
  closedAt             DateTime?

  photos          FaultPhoto[]
  comments        FaultComment[]
  events          FaultEvent[]
  equipmentEvents EquipmentEvent[]

  @@index([equipmentId])
  @@index([status])
  @@index([reportedById])
}

model FaultPhoto {
  id           String   @id @default(cuid())
  faultId      String
  fault        Fault    @relation(fields: [faultId], references: [id])
  fileName     String
  mimeType     String
  size         Int
  storageKey   String   @unique
  uploadedById String
  uploadedBy   User     @relation("FaultPhotosUploaded", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([faultId])
}

model FaultComment {
  id        String   @id @default(cuid())
  faultId   String
  fault     Fault    @relation(fields: [faultId], references: [id])
  text      String
  authorId  String
  author    User     @relation("FaultComments", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([faultId])
}

/// Every change of a fault's status: who and when.
model FaultEvent {
  id          String       @id @default(cuid())
  faultId     String
  fault       Fault        @relation(fields: [faultId], references: [id])
  fromStatus  FaultStatus?
  toStatus    FaultStatus
  createdById String
  createdBy   User         @relation("FaultEvents", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([faultId])
}

/// A personal calendar subscription to one's own roster (CLAUDE.md, 12.
/// mérföldkő): one live link per user. Only the hash of its key is kept; a new
/// link replaces the old one.
model CalendarFeed {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}
