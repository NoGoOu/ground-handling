generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// All DateTime values are stored in UTC and shown in Europe/Budapest time.

/// Scope of a permission: own, the teams the user leads, or everyone.
enum PermissionScope {
  SELF
  TEAM
  ALL
}

enum MilestoneAnchor {
  ARRIVAL
  DEPARTURE
}

enum MilestonePart {
  ARRIVAL_PART
  DEPARTURE_PART
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

/// Global settings, a single row with id "global" (decision 7).
model Setting {
  id                        String   @id @default("global")
  /// Deviation up to this many minutes is green.
  deviationGreenMaxMinutes  Int      @default(0)
  /// Deviation up to this many minutes is yellow, above it red.
  deviationYellowMaxMinutes Int      @default(5)
  updatedAt                 DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  active       Boolean  @default(true)
  teamId       String?
  team         Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles              UserRole[]
  permissions        UserPermission[]
  ledTeams           Team[]            @relation("TeamLeader")
  publications       Publication[]     @relation("PublishedBy")
  arrivalTasks       Task[]            @relation("ArrivalAgent")
  departureTasks     Task[]            @relation("DepartureAgent")
  recordedMilestones MilestoneRecord[] @relation("RecordedBy")
  updatedMilestones  MilestoneRecord[] @relation("UpdatedBy")
  shifts             Shift[]
  etaRecords         Flight[]          @relation("EtaRecordedBy")
  etdRecords         Flight[]          @relation("EtdRecordedBy")
  arrivalCancels     Flight[]          @relation("ArrivalCancelledBy")
  departureCancels   Flight[]          @relation("DepartureCancelledBy")
  flightEvents       FlightEvent[]
  importProfiles     ImportProfile[]
  importRuns         ImportRun[]
  importUploads      ImportUpload[]
  plansCreated       Plan[]            @relation("PlansCreated")
  planPositions      PlanPosition[]
}

/// A role is a name plus the permissions ticked for it (CLAUDE.md, "Jogosultsági rendszer").
model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  /// The Admin role cannot be edited or deleted.
  builtIn   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  id         String          @id @default(cuid())
  roleId     String
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Key from the permission catalogue in the code.
  permission String
  scope      PermissionScope @default(ALL)

  @@unique([roleId, permission])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// Extra permission given to one user on top of their roles. There is no individual revoke.
model UserPermission {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  scope      PermissionScope @default(ALL)

  @@unique([userId, permission])
}

/// A team has one leader; the "team" scope covers the members of the teams a user leads.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  leaderId  String
  leader    User     @relation("TeamLeader", fields: [leaderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members User[] @relation("TeamMembers")
}

/// The three layers of the roster (CLAUDE.md, "Beosztás rétegei").
enum RosterLayer {
  DRAFT
  PUBLISHED
  ACTUAL
}

/// Types of shift segment; only operative ones may carry flight tasks.
model SegmentType {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  operative Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments         ShiftSegment[]
  planningSettings PlanningSetting[]
}

/// One published period; the days it covers cannot be published again.
model Publication {
  id            String   @id @default(cuid())
  /// Local (Europe/Budapest) days, stored as the UTC instant of local midnight.
  startDate     DateTime
  endDate       DateTime
  publishedById String
  publishedBy   User     @relation("PublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime @default(now())

  shifts Shift[]

  @@index([startDate])
}

/// One agent's shift in one layer; its start and end come from its segments.
model Shift {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  layer         RosterLayer
  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id])
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  segments     ShiftSegment[]
  /// Set when "Mentés a tervezetbe" made this draft shift for a plan position.
  planPosition PlanPosition?

  @@index([userId, layer])
}

/// A part of a shift: time, type, and optionally a block with travel time.
model ShiftSegment {
  id                  String      @id @default(cuid())
  shiftId             String
  shift               Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  start               DateTime
  end                 DateTime
  segmentTypeId       String
  segmentType         SegmentType @relation(fields: [segmentTypeId], references: [id])
  location            String?
  description         String?
  /// Non-operative segments can show up as a block in the daily assignment.
  createBlock         Boolean     @default(false)
  /// Travel to and from the segment, in minutes; the block is widened by these.
  travelBeforeMinutes Int         @default(0)
  travelAfterMinutes  Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([shiftId])
  @@index([start])
}

model Airline {
  id                String               @id @default(cuid())
  name              String
  iataCode          String               @unique
  /// The template an imported flight of this airline gets (3. mérföldkő).
  defaultTemplateId String?
  defaultTemplate   TurnaroundTemplate?  @relation("AirlineDefaultTemplate", fields: [defaultTemplateId], references: [id])
  templates         TurnaroundTemplate[] @relation("AirlineTemplates")
  flights           Flight[]
}

model TurnaroundTemplate {
  id                     String  @id @default(cuid())
  airlineId              String
  airline                Airline @relation("AirlineTemplates", fields: [airlineId], references: [id])
  name                   String
  minTurnaroundMinutes   Int
  travelMinutes          Int
  postDepartureMinutes   Int
  departureReportMinutes Int
  minBreakMinutes        Int

  milestones MilestoneDefinition[]
  flights    Flight[]
  defaultFor Airline[]             @relation("AirlineDefaultTemplate")

  @@unique([airlineId, name])
}

model MilestoneDefinition {
  id            String             @id @default(cuid())
  templateId    String
  template      TurnaroundTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order         Int
  code          String
  name          String
  anchor        MilestoneAnchor
  offsetMinutes Int
  required      Boolean
  part          MilestonePart

  records MilestoneRecord[]

  @@unique([templateId, code])
}

model Flight {
  id                   String             @id @default(cuid())
  airlineId            String
  airline              Airline            @relation(fields: [airlineId], references: [id])
  templateId           String
  template             TurnaroundTemplate @relation(fields: [templateId], references: [id])
  /// The arrival part (flight number, STA, ETA, ATA) and the departure part
  /// (flight number, STD, ETD, ATD) are each optional, but one must exist
  /// (rule 11). Check constraints in the migration keep each part whole.
  inboundFlightNumber  String?
  outboundFlightNumber String?
  sta                  DateTime?
  eta                  DateTime?
  std                  DateTime?
  etd                  DateTime?
  /// Unknown until the shift lead sets it (an imported flight has none).
  stand                String?

  // 3. mérföldkő: where the flight comes from, and what identifies its legs.
  source              FlightSource   @default(MANUAL)
  /// Origin of the arrival part and destination of the departure part.
  origin              String?
  destination         String?
  /// Operating dates of the two legs (the departure day at the leg's origin).
  arrivalFlightDate   DateTime?      @db.Date
  departureFlightDate DateTime?      @db.Date
  aircraftType        String?
  aircraftConfig      String?
  importProfileId     String?
  importProfile       ImportProfile? @relation(fields: [importProfileId], references: [id])
  /// "Az utolsó importból hiányzik", per part, until the planner clears it.
  arrivalMissing      Boolean        @default(false)
  departureMissing    Boolean        @default(false)
  missingImportRunId  String?
  missingImportRun    ImportRun?     @relation("MissingFromImport", fields: [missingImportRunId], references: [id])
  /// From the external system.
  ata                 DateTime?
  /// From the external system.
  atd                 DateTime?

  // "Késés és törlés": where the current ETA and ETD came from.
  etaSource       EstimateSource?
  etaNote         String?
  etaRecordedById String?
  etaRecordedBy   User?           @relation("EtaRecordedBy", fields: [etaRecordedById], references: [id])
  etaRecordedAt   DateTime?
  etdSource       EstimateSource?
  etdNote         String?
  etdRecordedById String?
  etdRecordedBy   User?           @relation("EtdRecordedBy", fields: [etdRecordedById], references: [id])
  etdRecordedAt   DateTime?

  // Each part can be cancelled on its own; the flight itself is never deleted.
  arrivalCancelled       Boolean   @default(false)
  arrivalCancelledById   String?
  arrivalCancelledBy     User?     @relation("ArrivalCancelledBy", fields: [arrivalCancelledById], references: [id])
  arrivalCancelledAt     DateTime?
  departureCancelled     Boolean   @default(false)
  departureCancelledById String?
  departureCancelledBy   User?     @relation("DepartureCancelledBy", fields: [departureCancelledById], references: [id])
  departureCancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task?
  events FlightEvent[]

  @@unique([airlineId, inboundFlightNumber, arrivalFlightDate, origin])
  @@unique([airlineId, outboundFlightNumber, departureFlightDate, destination])
  @@index([sta])
  @@index([std])
}

model Task {
  id               String     @id @default(cuid())
  flightId         String     @unique
  flight           Flight     @relation(fields: [flightId], references: [id], onDelete: Cascade)
  status           TaskStatus @default(PLANNED)
  arrivalAgentId   String?
  arrivalAgent     User?      @relation("ArrivalAgent", fields: [arrivalAgentId], references: [id])
  departureAgentId String?
  departureAgent   User?      @relation("DepartureAgent", fields: [departureAgentId], references: [id])
  /// Template parameters and milestone definitions frozen when the task is completed.
  templateSnapshot Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  records   MilestoneRecord[]
  planItems PlanItem[]
}

model MilestoneRecord {
  id                    String              @id @default(cuid())
  taskId                String
  task                  Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestoneDefinitionId String
  milestoneDefinition   MilestoneDefinition @relation(fields: [milestoneDefinitionId], references: [id])
  /// Minute precision (seconds cut off).
  actualTime            DateTime
  recordedById          String
  recordedBy            User                @relation("RecordedBy", fields: [recordedById], references: [id])
  recordedAt            DateTime            @default(now())
  /// Set on the first correction, null until then.
  updatedById           String?
  updatedBy             User?               @relation("UpdatedBy", fields: [updatedById], references: [id])
  updatedAt             DateTime?

  @@unique([taskId, milestoneDefinitionId])
}

enum EstimateSource {
  MANUAL
  MESSAGE
}

enum FlightEventKind {
  DELAY
  CANCEL
  RESTORE
}

/// Log of delays, cancellations and restorations on a flight: who, when, what.
model FlightEvent {
  id          String          @id @default(cuid())
  flightId    String
  flight      Flight          @relation(fields: [flightId], references: [id], onDelete: Cascade)
  kind        FlightEventKind
  /// The cancelled or restored part; null for a delay.
  part        MilestonePart?
  /// The new estimates of a delay.
  eta         DateTime?
  etd         DateTime?
  source      EstimateSource?
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([flightId, createdAt])
}

enum FlightSource {
  MANUAL
  IMPORT
}

/// A saved column mapping; offered again for a file with the same header.
model ImportProfile {
  id                String   @id @default(cuid())
  name              String   @unique
  /// Hash of the normalised header row of the file the profile was made for.
  headerFingerprint String
  /// Sheet, header row, column mapping, transformations and filters.
  mapping           Json
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  flights Flight[]
  runs    ImportRun[]

  @@index([headerFingerprint])
}

/// Log of a saved import: who, when, which file, which profile, and the summary.
model ImportRun {
  id          String         @id @default(cuid())
  profileId   String?
  profile     ImportProfile? @relation(fields: [profileId], references: [id])
  fileName    String
  fileSize    Int
  rangeStart  DateTime       @db.Date
  rangeEnd    DateTime       @db.Date
  summary     Json
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  missingFlights Flight[] @relation("MissingFromImport")

  @@index([createdAt])
}

/// An uploaded file kept between the steps of the import; removed after a day.
model ImportUpload {
  id          String   @id @default(cuid())
  fileName    String
  size        Int
  content     Bytes
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// 4. mérföldkő: tervezői nézet, automatikus kiosztással.

/// The rules of the automatic plan (CLAUDE.md, "Tervezési beállítások").
/// One row; a plan day keeps its own copy from its calculation.
model PlanningSetting {
  id                String       @id @default("global")
  minShiftMinutes   Int          @default(240)
  maxShiftMinutes   Int          @default(720)
  breakMinutes      Int          @default(20)
  /// A shift longer than this needs a break.
  breakAfterMinutes Int          @default(360)
  /// Rest between two tasks; only one of rest and overlap may be above zero.
  restMinutes       Int          @default(0)
  /// Allowed overlap of two tasks.
  overlapMinutes    Int          @default(0)
  /// Positions allowed above the minimum, for an even load.
  extraPositions    Int          @default(0)
  /// Type of the single segment "Mentés a tervezetbe" writes (Műszak by default).
  segmentTypeId     String?
  segmentType       SegmentType? @relation(fields: [segmentTypeId], references: [id], onDelete: SetNull)
  updatedAt         DateTime     @updatedAt
}

/// The part of a task an occupancy window covers: WHOLE on a quick turnaround.
enum WindowPart {
  WHOLE
  ARRIVAL_PART
  DEPARTURE_PART
}

/// A plan for a period (Budapest days); it is calculated day by day.
model Plan {
  id          String   @id @default(cuid())
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  createdById String
  createdBy   User     @relation("PlansCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days PlanDay[]
}

/// One day of a plan. Its items are the day's windows as calculated: when
/// the windows of the tasks change, the day is stale.
model PlanDay {
  id           String   @id @default(cuid())
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  /// The planning settings at the calculation.
  settings     Json
  calculatedAt DateTime

  positions PlanPosition[]
  items     PlanItem[]

  @@unique([planId, date])
}

/// A nameless position ("1. pozíció"): a future shift.
model PlanPosition {
  id      String  @id @default(cuid())
  dayId   String
  day     PlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  number  Int
  /// The agent the planner names for the position.
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The draft shift saved from this position; replaced by the next save.
  shiftId String? @unique
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  items PlanItem[]

  @@unique([dayId, number])
}

/// An occupancy window in a position, with its times at the calculation.
model PlanItem {
  id         String       @id @default(cuid())
  dayId      String
  day        PlanDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  positionId String
  position   PlanPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  part       WindowPart
  start      DateTime
  end        DateTime
  /// Moved by hand; a recalculation overwrites it.
  manual     Boolean      @default(false)

  @@unique([dayId, taskId, part])
  @@index([positionId])
}
